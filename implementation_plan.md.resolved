#### [MODIFY] [CanvasPreview.tsx](file:///f:/Aniruddha/code/webdev/PROJECTS/aislop/client1/src/app/components/editor/CanvasPreview.tsx)

Add a `<canvas>` layer that uses `CanvasCompositor` for instant scrub feedback when WebCodecs is available. Fall back to the existing `<video>` element when not supported or during full playback.

**Key changes:**
- Add a `<canvas>` element behind the `<video>` element
- On scrub (paused), render via `CanvasCompositor` instead of requesting a server segment
- On play, switch to the existing HLS `<video>` playback path (compositor hides)
- Add `useEffect` to initialize `CanvasCompositor` when template URL is available

```diff
 // Add imports
+import { CanvasCompositor } from '@/lib/canvasCompositor';
+import { MediaEngine } from '@/lib/mediaEngine';

 // Inside component, add refs
+const compositorRef = useRef<CanvasCompositor | null>(null);
+const canvasRef = useRef<HTMLCanvasElement | null>(null);
+const webCodecsSupported = useRef(MediaEngine.isSupported());

 // Add initialization effect
+useEffect(() => {
+  if (!webCodecsSupported.current || !canvasRef.current) return;
+  const compositor = new CanvasCompositor(canvasRef.current);
+  compositorRef.current = compositor;
+  
+  const templateUrl = getTemplateUrl(project.template.src);
+  if (templateUrl) {
+    compositor.loadTemplate(templateUrl).catch(console.warn);
+    compositor.preloadImages(project);
+  }
+  return () => compositor.dispose();
+}, [project.template.src, project.id]);

 // Add scrub render effect (replaces segment preview requests)
+useEffect(() => {
+  if (isPlaying || !compositorRef.current || !webCodecsSupported.current) return;
+  // Render composited frame instantly on canvas
+  compositorRef.current.renderFrame(project, playheadTime).catch(console.warn);
+}, [playheadTime, isPlaying, project]);

 // In JSX, add canvas element
+{webCodecsSupported.current && (
+  <canvas
+    ref={canvasRef}
+    className="absolute inset-0 w-full h-full"
+    style={{ 
+      zIndex: isPlaying ? 10 : 30,  // Behind video during play, in front during scrub
+      display: isPlaying ? 'none' : 'block',
+      objectFit: 'contain',
+    }}
+  />
+)}
```

