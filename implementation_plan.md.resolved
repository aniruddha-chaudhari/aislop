### Phase 3: Audio Preview with Web Audio API (Optional)

For audio during playback (not just scrub), the existing HLS approach works. But for scrub audio feedback:

#### [NEW] [audioEngine.ts](file:///f:/Aniruddha/code/webdev/PROJECTS/aislop/client1/src/lib/audioEngine.ts)

```typescript
// client1/src/lib/audioEngine.ts
export class AudioEngine {
  private audioContext: AudioContext | null = null;
  private audioBuffer: AudioBuffer | null = null;
  private source: AudioBufferSourceNode | null = null;

  async loadAudio(url: string): Promise<void> {
    this.audioContext = new AudioContext();
    const response = await fetch(url);
    const arrayBuffer = await response.arrayBuffer();
    this.audioBuffer = await this.audioContext.decodeAudioData(arrayBuffer);
  }

  playFrom(timeSeconds: number): void {
    if (!this.audioContext || !this.audioBuffer) return;
    this.stop();
    this.source = this.audioContext.createBufferSource();
    this.source.buffer = this.audioBuffer;
    this.source.connect(this.audioContext.destination);
    this.source.start(0, timeSeconds);
  }

  stop(): void {
    this.source?.stop();
    this.source = null;
  }

  dispose(): void {
    this.stop();
    this.audioContext?.close();
  }
}
```

