{"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Escaped the Sandbox</title>\n<style>\n  :root {\n    --bg: #121212;\n    --primary: #CF6A87;\n    --accent: #F5CD79;\n    --text: #FFFFFF;\n    \n    --glow-blue-core: rgba(150, 210, 255, 0.9);\n    --glow-blue-inner: rgba(60, 140, 255, 0.5);\n    --glow-blue-outer: rgba(30, 80, 200, 0.3);\n    \n    --border-white: rgba(200, 220, 255, 0.9);\n    --border-glow: rgba(100, 180, 255, 0.4);\n    \n    --red-hot: #FF3B1F;\n    --red-orange: #FF6B35;\n    --gold: #FFD700;\n  }\n\n  html, body {\n    margin: 0;\n    padding: 0;\n    width: 1080px;\n    height: 1920px;\n    background-color: var(--bg);\n    overflow: hidden;\n    font-family: 'Bebas Neue', Impact, sans-serif;\n  }\n\n  .scene-root {\n    position: relative;\n    width: 1080px;\n    height: 1920px;\n    background-color: var(--bg);\n    transform-origin: 540px 960px;\n  }\n\n  /* Ambient Backdrop */\n  .ambient-glow {\n    position: absolute;\n    left: 140px; /* 540 - 400 */\n    top: 848px;  /* 1920 * 0.65 - 400 = 1248 - 400 */\n    width: 800px;\n    height: 800px;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(0, 20, 80, 0.6) 0%, rgba(0, 20, 80, 0) 70%);\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  /* Context Anchor: Sandbox */\n  .sandbox-container {\n    position: absolute;\n    left: 260px; /* 540 - 280 */\n    top: 700px;\n    width: 560px;\n    height: 520px;\n    z-index: 2;\n  }\n\n  .sandbox-svg {\n    width: 100%;\n    height: 100%;\n    overflow: visible;\n  }\n\n  .sandbox-border {\n    fill: none;\n    stroke: var(--border-white);\n    stroke-width: 3px;\n    stroke-dasharray: 18 12;\n    filter: drop-shadow(0 0 8px var(--border-glow));\n    /* Animation handled by GSAP to ensure deterministic sync */\n  }\n\n  /* The Glowing Dot */\n  .dot-container {\n    position: absolute;\n    left: 522px; /* 540 - 18 */\n    top: 942px;  /* 960 - 18 */\n    width: 36px;\n    height: 36px;\n    z-index: 5;\n  }\n\n  .dot-core {\n    width: 100%;\n    height: 100%;\n    background-color: #FFFFFF;\n    border-radius: 50%;\n    filter: drop-shadow(0 0 12px var(--glow-blue-core)) \n            drop-shadow(0 0 30px var(--glow-blue-inner)) \n            drop-shadow(0 0 70px var(--glow-blue-outer));\n  }\n\n  /* Ascent Trail */\n  .trail {\n    position: absolute;\n    left: 528px; /* 540 - 12 */\n    top: 200px;  /* Max ascent point */\n    width: 24px;\n    height: 500px; /* From 200px down to 700px */\n    background: linear-gradient(to bottom, rgba(120, 200, 255, 0.7) 0%, transparent 100%);\n    filter: drop-shadow(2px 0 0 rgba(255,0,0,0.5)) drop-shadow(-2px 0 0 rgba(0,255,255,0.5));\n    transform-origin: top center;\n    opacity: 0;\n    z-index: 4;\n  }\n\n  /* Hero Text */\n  .title-container {\n    position: absolute;\n    left: 0;\n    top: 600px;\n    width: 1080px;\n    text-align: center;\n    color: var(--text);\n    z-index: 6;\n    clip-path: inset(100% 0% 0% 0%); /* Starts fully masked */\n  }\n\n  .title-line1 {\n    font-size: 96px;\n    letter-spacing: 0.08em;\n    line-height: 1;\n    margin: 0;\n    text-shadow: 0 0 20px rgba(100, 180, 255, 0.9), \n                 0 0 60px rgba(60, 120, 255, 0.5), \n                 0 0 120px rgba(30, 80, 200, 0.3);\n  }\n\n  .title-line2 {\n    font-size: 148px;\n    letter-spacing: 0.05em;\n    line-height: 1;\n    margin: 0;\n    text-shadow: 0 0 20px rgba(100, 180, 255, 0.9), \n                 0 0 60px rgba(60, 120, 255, 0.5), \n                 0 0 120px rgba(30, 80, 200, 0.3);\n  }\n\n  .title-glitch-layer {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    color: var(--text);\n    text-align: center;\n    opacity: 0;\n    pointer-events: none;\n    z-index: 7;\n  }\n\n  .title-glitch-layer .title-line1, .title-glitch-layer .title-line2 {\n    text-shadow: none;\n  }\n\n  /* Debris Particles */\n  .debris-container {\n    position: absolute;\n    left: 540px;\n    top: 700px;\n    width: 0;\n    height: 0;\n    z-index: 8;\n    overflow: visible;\n  }\n\n  .particle {\n    position: absolute;\n    background-color: var(--red-orange);\n    opacity: 0;\n    filter: blur(1px);\n    box-shadow: 0 0 8px var(--red-orange);\n  }\n</style>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n</head>\n<body>\n\n<div class=\"scene-root\" data-composition-id=\"main\" data-start=\"0\" data-duration=\"3.5\" data-width=\"1080\" data-height=\"1920\">\n  \n  <div class=\"ambient-glow\"></div>\n\n  <div class=\"sandbox-container\">\n    <svg class=\"sandbox-svg\" viewBox=\"0 0 560 520\">\n      <!-- \n        Total perimeter: 560 + 520 + 560 + 520 = 2160\n        Starts top-left (0,0), draws clockwise. \n      -->\n      <rect x=\"0\" y=\"0\" width=\"560\" height=\"520\" class=\"sandbox-border\" id=\"box-stroke\" stroke-dasharray=\"2160\" stroke-dashoffset=\"2160\" />\n      \n      <!-- The broken state: 3 sides (right, bottom, left) -->\n      <polyline points=\"560,0 560,520 0,520 0,0\" fill=\"none\" stroke=\"var(--red-hot)\" stroke-width=\"3\" stroke-dasharray=\"18 12\" filter=\"drop-shadow(0 0 12px var(--red-hot))\" id=\"box-broken\" opacity=\"0\" />\n    </svg>\n  </div>\n\n  <div class=\"trail\" id=\"energy-trail\"></div>\n\n  <div class=\"dot-container\" id=\"dot\">\n    <div class=\"dot-core\" id=\"dot-core\"></div>\n  </div>\n\n  <!-- Debris container -->\n  <div class=\"debris-container\" id=\"debris\">\n    <!-- Particles injected via JS loop for compactness/determinism -->\n  </div>\n\n  <div class=\"title-container\" id=\"hero-text\">\n    <p class=\"title-line1\">ESCAPED THE</p>\n    <p class=\"title-line2\">SANDBOX</p>\n  </div>\n\n  <!-- Glitch layers for RGB split -->\n  <div class=\"title-glitch-layer\" id=\"glitch-red\" style=\"transform: translateX(-4px); filter: hue-rotate(-90deg) saturate(2) brightness(0.5) drop-shadow(2px 0 0 red);\">\n    <p class=\"title-line1\">ESCAPED THE</p>\n    <p class=\"title-line2\">SANDBOX</p>\n  </div>\n  <div class=\"title-glitch-layer\" id=\"glitch-cyan\" style=\"transform: translateX(4px); filter: hue-rotate(90deg) saturate(2) brightness(0.5) drop-shadow(-2px 0 0 cyan);\">\n    <p class=\"title-line1\">ESCAPED THE</p>\n    <p class=\"title-line2\">SANDBOX</p>\n  </div>\n\n  <script>\n    // Deterministic particle generation\n    const debrisContainer = document.getElementById('debris');\n    const particles = [];\n    const colors = ['#FF3B1F', '#FF6B35', '#FFD700'];\n    \n    // Simple deterministic PRNG\n    let seed = 12345;\n    function random() {\n      seed = (seed * 9301 + 49297) % 233280;\n      return seed / 233280;\n    }\n\n    for (let i = 0; i < 24; i++) {\n      const p = document.createElement('div');\n      p.className = 'particle';\n      \n      const size = 3 + random() * 6; // 3px to 9px\n      p.style.width = size + 'px';\n      p.style.height = (size * (1 + random() * 0.5)) + 'px'; // slightly rectangular\n      \n      const color = colors[Math.floor(random() * colors.length)];\n      p.style.backgroundColor = color;\n      p.style.boxShadow = `0 0 8px ${color}`;\n      \n      debrisContainer.appendChild(p);\n      particles.push(p);\n    }\n\n    window.__timelines = window.__timelines || {};\n    const tl = gsap.timeline({ paused: true });\n\n    // ==========================================\n    // Phase map:\n    // 0.0 - 0.8: Draw border, idle pulse\n    // 0.8 - 1.0: Charge wind-up\n    // 1.0 - 1.2: Punch upward\n    // 1.2:       BREACH (Border shatter, particles)\n    // 1.2 - 1.6: Ascent trail + text wipe reveal\n    // 1.8 - 3.2: Hold state (idle window, glitches, flickers)\n    // 3.2 - 3.5: Exit scale down & fade out\n    // ==========================================\n\n    // --- Background / Border Marching Ants (Continuous) ---\n    // Instead of infinite repeat, we animate dash offset linearly across 3.5s\n    // Speed: -30px/s * 3.5s = -105px\n    tl.to(\"#box-stroke\", {\n      strokeDashoffset: \"-=105\",\n      duration: 3.5,\n      ease: \"none\"\n    }, 0);\n    \n    // Also march the broken box dashes once it appears\n    tl.fromTo(\"#box-broken\", \n      { strokeDashoffset: 0 },\n      { strokeDashoffset: -69, duration: 2.3, ease: \"none\" }, 1.2);\n\n    // --- Phase 1: Draw On (0.0 -> 0.8) ---\n    tl.addLabel('entry', 0.0);\n    \n    // Draw perimeter\n    tl.fromTo(\"#box-stroke\", \n      { strokeDasharray: \"0 2160\" },\n      { strokeDasharray: \"2160 2160\", duration: 0.8, ease: \"power2.out\" }, \n      \"entry\");\n\n    // Dot idle pulse (0.0 -> 0.8)\n    // 1.2s sine loop would be 1.0 -> 1.15 -> 1.0. We only have 0.8s, so it does a partial cycle\n    tl.to(\"#dot\", {\n      scale: 1.15,\n      duration: 0.4,\n      ease: \"sine.inOut\"\n    }, \"entry\")\n    .to(\"#dot\", {\n      scale: 1.0,\n      duration: 0.4,\n      ease: \"sine.inOut\"\n    }, \"entry+=0.4\");\n\n    tl.to(\"#dot-core\", {\n      opacity: 0.6,\n      duration: 0.4,\n      ease: \"sine.inOut\"\n    }, \"entry\")\n    .to(\"#dot-core\", {\n      opacity: 1.0,\n      duration: 0.4,\n      ease: \"sine.inOut\"\n    }, \"entry+=0.4\");\n\n    // --- Phase 2: Charge Wind-Up (0.8 -> 1.0) ---\n    tl.addLabel('charge', 0.8);\n    \n    // Squash anticipation\n    tl.to(\"#dot\", {\n      scaleX: 1.3,\n      scaleY: 0.7,\n      duration: 0.2,\n      ease: \"power2.in\"\n    }, \"charge\");\n    \n    // Glow intensifies (using drop-shadow spread via string interpolation or filter proxy)\n    tl.to(\"#dot-core\", {\n      filter: \"drop-shadow(0 0 24px rgba(150, 210, 255, 1)) drop-shadow(0 0 60px rgba(60, 140, 255, 0.8)) drop-shadow(0 0 160px rgba(30, 80, 200, 0.6))\",\n      duration: 0.2,\n      ease: \"power2.in\"\n    }, \"charge\");\n\n    // Screen-wide flicker at 0.9s\n    tl.to(\".scene-root\", { filter: \"brightness(1.08)\", duration: 0.05, ease: \"none\" }, 0.9);\n    tl.to(\".scene-root\", { filter: \"brightness(1.0)\", duration: 0.05, ease: \"none\" }, 0.95);\n\n    // --- Phase 3: Punch (1.0 -> 1.2) ---\n    tl.addLabel('punch_start', 1.0);\n    \n    // Snap back to round\n    tl.to(\"#dot\", {\n      scaleX: 1.0,\n      scaleY: 1.0,\n      duration: 0.05, // instantly\n      ease: \"none\"\n    }, \"punch_start\");\n\n    // Accelerate upward: 942px -> 442px (-500px relative)\n    // Breach point is at Y=700 (-242px relative) at 1.2s\n    tl.to(\"#dot\", {\n      y: -500, \n      duration: 0.2,\n      ease: \"expo.in\"\n    }, \"punch_start\");\n\n    // --- Phase 4: Breach & Ascent (1.2 -> 1.8) ---\n    tl.addLabel('punch', 1.2); // The critical breach moment\n\n    // Border shatter\n    tl.to(\"#box-stroke\", { opacity: 0, duration: 0.1, ease: \"none\" }, \"punch\");\n    tl.to(\"#box-broken\", { opacity: 1, duration: 0.15, ease: \"none\" }, \"punch\");\n\n    // Debris explosion\n    particles.forEach((p, i) => {\n      // Radial burst upward\n      const angleDeg = 120 + random() * 120; // 120 to 240 (upward arc)\n      const angleRad = angleDeg * Math.PI / 180;\n      const speed = 80 + random() * 200;\n      \n      // Calculate destination roughly based on physics over 0.5s to 1.0s\n      const lifespan = 0.5 + random() * 0.5;\n      \n      // Use GSAP physics plugin or simulate with standard tweens\n      const destX = Math.cos(angleRad) * speed * lifespan;\n      // y includes gravity: v_0*t + 0.5*a*t^2 (gravity ~ 120px/s^2 -> 60*t^2)\n      const destY = (Math.sin(angleRad) * speed * lifespan) + (60 * lifespan * lifespan);\n      \n      tl.set(p, { opacity: 1 }, \"punch\");\n      \n      tl.to(p, {\n        x: destX,\n        y: destY,\n        rotation: -90 + random() * 180,\n        duration: lifespan,\n        ease: \"power1.out\" // Simulate initial burst slowing down horizontally\n      }, \"punch\");\n      \n      // Fade out\n      tl.to(p, {\n        opacity: 0,\n        duration: lifespan,\n        ease: \"power2.in\"\n      }, \"punch\");\n    });\n\n    // Dot continues upward (1.2 -> 1.8) Y: 442 -> -742 (-1200 relative to 942)\n    // Actually the prompt says 960 -> 460 at 1.2, then 700 -> 200 over 0.6s.\n    // Let's refine the total Y path.\n    // Start Y is 942. At 1.2s it crossed 700. It continues to 200.\n    // Let's just tween to Y=-742 (which is absolute 200) from 1.2 to 1.8\n    tl.to(\"#dot\", {\n      y: -742,\n      duration: 0.6,\n      ease: \"power2.out\"\n    }, \"punch\");\n\n    // Energy beam trail\n    tl.to(\"#energy-trail\", { opacity: 1, duration: 0.1, ease: \"none\" }, \"punch\");\n    tl.fromTo(\"#energy-trail\",\n      { scaleY: 0 },\n      { scaleY: 1, duration: 0.6, ease: \"power2.out\" },\n      \"punch\"\n    );\n\n    // Text wipe reveal: bottom to top\n    tl.fromTo(\"#hero-text\",\n      { clipPath: \"inset(100% 0% 0% 0%)\" },\n      { clipPath: \"inset(0% 0% 0% 0%)\", duration: 0.4, ease: \"power3.out\" },\n      \"punch\"\n    );\n\n    // Glitch Flashes on Text\n    const glitchTimes = [1.4, 1.55, 1.9, 2.3];\n    glitchTimes.forEach(t => {\n      // Flash on\n      tl.set([\"#glitch-red\", \"#glitch-cyan\"], { opacity: 0.8 }, t);\n      // Random shift\n      const shift1 = -5 + random() * 10;\n      const shift2 = -5 + random() * 10;\n      tl.set(\"#glitch-red\", { x: shift1 }, t);\n      tl.set(\"#glitch-cyan\", { x: shift2 }, t);\n      // Flash off\n      tl.set([\"#glitch-red\", \"#glitch-cyan\"], { opacity: 0 }, t + 0.05);\n    });\n\n    // --- Phase 5: Hold (1.8 -> 3.2) ---\n    // // hold state\n    tl.addLabel('hold', 1.8);\n\n    // Dot float (sine oscillation)\n    tl.to(\"#dot\", { y: \"-=8\", duration: 0.5, ease: \"sine.inOut\" }, \"hold\")\n      .to(\"#dot\", { y: \"+=16\", duration: 1.0, ease: \"sine.inOut\" }, \"hold+=0.5\")\n      .to(\"#dot\", { y: \"-=8\", duration: 0.5, ease: \"sine.inOut\" }, \"hold+=1.5\");\n\n    // Text glow pulse & scale breathe\n    tl.to(\"#hero-text\", { scale: 1.008, duration: 1.0, ease: \"sine.inOut\" }, \"hold\")\n      .to(\"#hero-text\", { scale: 1.0, duration: 1.0, ease: \"sine.inOut\" }, \"hold+=1.0\");\n\n    // Border flicker\n    const flickerTimes = [2.0, 2.4, 2.7, 3.0];\n    flickerTimes.forEach(t => {\n      tl.to(\"#box-broken\", { opacity: 0.3, duration: 0.04, ease: \"none\" }, t)\n        .to(\"#box-broken\", { opacity: 1.0, duration: 0.04, ease: \"none\" }, t + 0.04);\n    });\n    // Strobe frame\n    tl.set(\"#box-broken\", { opacity: 0 }, 2.2)\n      .set(\"#box-broken\", { opacity: 1 }, 2.216);\n\n    // Beam breathe\n    tl.to(\"#energy-trail\", { opacity: 0.5, duration: 0.7, ease: \"sine.inOut\" }, \"hold\")\n      .to(\"#energy-trail\", { opacity: 0.8, duration: 0.7, ease: \"sine.inOut\" }, \"hold+=0.7\");\n\n    // --- Exit Sequence (3.2 -> 3.5) ---\n    tl.addLabel('exit', 3.2);\n    \n    tl.to(\".scene-root\", {\n      scale: 0.82,\n      opacity: 0,\n      duration: 0.3,\n      ease: \"power2.inOut\"\n    }, \"exit\");\n\n    window.__timelines[\"main\"] = tl;\n  </script>\n</div>\n\n</body>\n</html>"}
