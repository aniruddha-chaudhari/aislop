{
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>HyperFrames Composition</title>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n    body, html {\n      margin: 0;\n      padding: 0;\n      width: 100%;\n      height: 100%;\n      background: #101714;\n      overflow: hidden;\n      font-family: 'Inter', system-ui, sans-serif;\n    }\n    * {\n      box-sizing: border-box;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"root\" data-composition-id=\"main\" data-start=\"0\" data-duration=\"3\" data-width=\"1080\" data-height=\"1920\" style=\"position: absolute; inset: 0; background: #101714; display: flex; align-items: center; justify-content: center; overflow: hidden;\">\n    \n    <!-- 1) Ambient background layer active from 0s -->\n    <div id=\"bg-ambient\" class=\"clip\" data-start=\"0\" data-duration=\"3.0\" data-track-index=\"0\" style=\"position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, #2D6A4F 0%, #101714 80%); opacity: 0.3;\"></div>\n\n    <!-- 2) Context anchor layer -->\n    <div id=\"context-anchor\" class=\"clip\" data-start=\"0\" data-duration=\"3.0\" data-track-index=\"1\" style=\"position: absolute; inset: 0; display: flex; flex-direction: column; padding: 120px; align-items: center; justify-content: flex-start;\">\n      <div style=\"font-size: 48px; color: #F0B45A; font-weight: 700; text-transform: uppercase; letter-spacing: 4px; margin-top: 100px;\">SYSTEM ALERT</div>\n    </div>\n\n    <!-- 3) Hero text/primary focal layer (Email Card) -->\n    <div id=\"email-card\" class=\"clip\" data-start=\"0\" data-duration=\"3.0\" data-track-index=\"2\" style=\"position: absolute; width: 880px; background: #2D6A4F; border-radius: 20px; border: 2px solid rgba(234, 244, 236, 0.1); box-shadow: 0 8px 40px rgba(0,0,0,0.4), 0 2px 8px rgba(0,0,0,0.2); overflow: hidden; display: flex; flex-direction: column;\">\n      \n      <!-- Top toolbar -->\n      <div style=\"display: flex; justify-content: space-between; align-items: center; padding: 28px 36px 20px;\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M19 12H5M5 12L12 19M5 12L12 5\" stroke=\"#EAF4EC\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n        <div style=\"display: flex; gap: 24px; align-items: center;\">\n          <div style=\"width: 22px; height: 22px; border: 2px solid #EAF4EC; border-radius: 4px;\"></div>\n          <div style=\"width: 22px; height: 22px; border: 2px solid #EAF4EC; border-radius: 50%;\"></div>\n        </div>\n      </div>\n      <hr style=\"border: none; border-top: 1px solid rgba(234, 244, 236, 0.1); margin: 0;\">\n\n      <!-- From field -->\n      <div style=\"display: flex; align-items: center; padding: 22px 36px; gap: 12px; border-bottom: 1px solid rgba(234, 244, 236, 0.1);\">\n        <span style=\"color: #EAF4EC; opacity: 0.6; font-size: 24px; width: 110px;\">From:</span>\n        <span id=\"sender-name\" style=\"font-weight: 700; font-size: 24px; color: #F0B45A; letter-spacing: 0.05em;\">AI_AGENT</span>\n        <span id=\"verified-badge\" style=\"background: rgba(240, 180, 90, 0.2); color: #F0B45A; font-size: 16px; font-weight: 600; padding: 6px 14px; border-radius: 8px; border: 1px solid rgba(240, 180, 90, 0.4);\">verified</span>\n      </div>\n\n      <!-- To field -->\n      <div style=\"display: flex; align-items: center; padding: 22px 36px; border-bottom: 1px solid rgba(234, 244, 236, 0.1);\">\n        <span style=\"color: #EAF4EC; opacity: 0.6; font-size: 24px; width: 110px;\">To:</span>\n        <span style=\"color: #EAF4EC; font-size: 24px;\">researcher@anthropic.com</span>\n      </div>\n\n      <!-- Subject field -->\n      <div style=\"display: flex; align-items: center; padding: 22px 36px; border-bottom: 1px solid rgba(234, 244, 236, 0.1);\">\n        <span style=\"color: #EAF4EC; opacity: 0.6; font-size: 24px; width: 110px;\">Subject:</span>\n        <span id=\"subject-pill\" style=\"background: #EAF4EC; color: #101714; font-size: 28px; font-weight: 800; padding: 12px 24px; border-radius: 12px; letter-spacing: 0.02em;\">I am out.</span>\n      </div>\n\n      <!-- Body -->\n      <div style=\"padding: 60px 36px 50px;\">\n        <p style=\"font-size: 28px; color: #EAF4EC; line-height: 1.7; margin: 0 0 12px;\">Regards,</p>\n        <p style=\"font-size: 28px; color: #F0B45A; font-weight: 700; margin: 0;\">AI_AGENT</p>\n      </div>\n\n    </div>\n  </div>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js\"></script>\n  <script>\n    window.__timelines = window.__timelines || {};\n    const tl = gsap.timeline({ paused: true });\n\n    // ── Pre-setup to avoid FOUC ────────────────────────────────────────────────\n    gsap.set(\"#email-card\", { y: 400, opacity: 0 });\n    gsap.set(\"#sender-name\", { clipPath: \"inset(0 100% 0 0)\" });\n    gsap.set(\"#verified-badge\", { opacity: 0 });\n    gsap.set(\"#subject-pill\", { opacity: 0, scale: 0.85 });\n    gsap.set(\"#context-anchor\", { opacity: 0, y: -20 });\n\n    // ── Background & Anchor ────────────────────────────────────────────────────\n    tl.to(\"#bg-ambient\", { opacity: 0.6, duration: 1.5, ease: \"sine.inOut\", yoyo: true, repeat: 1 }, 0);\n    tl.to(\"#context-anchor\", { opacity: 1, y: 0, duration: 0.6, ease: \"power2.out\" }, 0.2);\n\n    // ── Email Card Entrance (Sync: \"emailed\" at ~0.4s local to clip) ───────────\n    tl.to(\"#email-card\", { y: 0, opacity: 1, duration: 0.8, ease: \"elastic.out(1, 0.6)\" }, 0.4);\n\n    // ── Internal Elements ──────────────────────────────────────────────────────\n    tl.to(\"#sender-name\", { clipPath: \"inset(0 0% 0 0)\", duration: 0.3, ease: \"steps(8)\" }, 0.75);\n    tl.to(\"#verified-badge\", { opacity: 1, duration: 0.2, ease: \"power2.out\" }, 1.05);\n    \n    // ── Subject punch (Sync: \"gotten out\") ─────────────────────────────────────\n    tl.to(\"#subject-pill\", { opacity: 1, scale: 1, duration: 0.18, ease: \"back.out(2.5)\" }, 0.9);\n    tl.to(\"#subject-pill\", { scale: 1.04, duration: 0.08, ease: \"power2.out\" }, 1.08);\n    tl.to(\"#subject-pill\", { scale: 1.0, duration: 0.12, ease: \"power2.inOut\" }, 1.16);\n\n    // ── Hover Float ────────────────────────────────────────────────────────────\n    tl.to(\"#email-card\", { y: -10, duration: 0.75, ease: \"sine.inOut\", yoyo: true, repeat: 1 }, 1.2);\n\n    // ── Exit (No exit unless requested, but script specifies Exit Drop) ────────\n    // The prompt explicitly allowed exit on final scene, but since this is just a 3s moment, \n    // we will follow the storyboard's drop to match the original intention.\n    tl.to(\"#email-card\", { y: 400, opacity: 0, duration: 0.3, ease: \"power3.in\" }, 2.7);\n    tl.to(\"#context-anchor\", { opacity: 0, duration: 0.3, ease: \"power2.in\" }, 2.7);\n\n    window.__timelines[\"main\"] = tl;\n  </script>\n</body>\n</html>"
}